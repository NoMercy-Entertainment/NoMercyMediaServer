{
  "$schema": "http://json.schemastore.org/template",
  "author": "NoMercy Entertainment",
  "classifications": [ "NoMercy", "Plugin", "Media Server" ],
  "identity": "NoMercy.Plugin.Template",
  "name": "NoMercy MediaServer Plugin",
  "shortName": "nomercy-plugin",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "NoMercy.Plugin.Template",
  "preferNameDirectory": true,
  "symbols": {
    "pluginId": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "replaces": "PLUGIN-ULID-PLACEHOLDER",
      "description": "The plugin's id, as a ULID. Every id NoMercy issues is a ULID; dotnet new has no ULID generator, so this is passed in rather than generated."
    },
    "authorName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "AUTHOR-NAME-PLACEHOLDER",
      "description": "The plugin author's name"
    },
    "pluginDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "A NoMercy MediaServer plugin",
      "replaces": "PLUGIN-DESCRIPTION-PLACEHOLDER",
      "description": "A short description of the plugin"
    }
  }
}
