<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NoMercy.Storage</RootNamespace>
    <AssemblyName>NoMercy.Storage</AssemblyName>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoMercy.Tests.Storage" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="WebDav.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <!-- libnfs native binaries — built by packages/nomercy-libnfs/scripts/build.sh -->
  <!-- Condition="Exists(...)" keeps the project buildable when output/ is empty.  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/win-x64/libnfs.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/win-x64/libnfs.dll')"
          Link="runtimes/win-x64/native/libnfs.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/linux-x64/libnfs.so"
          Condition="Exists('$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/linux-x64/libnfs.so')"
          Link="runtimes/linux-x64/native/libnfs.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/linux-arm64/libnfs.so"
          Condition="Exists('$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/linux-arm64/libnfs.so')"
          Link="runtimes/linux-arm64/native/libnfs.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/osx-x64/libnfs.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/osx-x64/libnfs.dylib')"
          Link="runtimes/osx-x64/native/libnfs.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/osx-arm64/libnfs.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)../../../../packages/nomercy-libnfs/output/osx-arm64/libnfs.dylib')"
          Link="runtimes/osx-arm64/native/libnfs.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
